# ── OpenRouter (مخّ الوكيل) ─────────────────────────────────
# أنشئ مفتاحاً مجانياً من https://openrouter.ai/keys ثم ضعه هنا
# بدون هذا المفتاح يعمل النظام بوضع المحاكاة المحلية (Offline Simulation)
OPENROUTER_API_KEY=

# سلسلة الموديلات: الأول للتفكير العميق ثم بدائل عند الفشل أو ضعف الحصة
OPENROUTER_MODELS=anthropic/claude-sonnet-4.5,openai/gpt-4o-mini,google/gemini-2.0-flash-001

# ── Google Gemini (اختياري: Adapter مباشر، غير مفعّل في Planner) ──
# يقبل GOOGLE_API_KEY كاسم توافقي بديل. المفتاح يبقى على السيرفر فقط.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta

# ── Supabase (اختياري: تخزين دائم مجاني) ────────────────────
# أنشئ مشروعاً مجانياً من https://supabase.com بدون بطاقة
# إذا تُرك فارغاً يعمل النظام بتخزين الذاكرة المؤقتة
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
